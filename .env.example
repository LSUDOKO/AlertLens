# Leave as-is for offline mode. No key is needed.
LLM_PROVIDER=mock            # mock | ollama | openai_compat | gemini | anthropic
LLM_MODEL=                   # e.g. a local instruct model name for ollama
LLM_BASE_URL=http://localhost:11434
LLM_API_KEY=
QUARANTINE_PROVIDER=mock     # can differ from the main provider
EMBEDDINGS=tfidf             # tfidf | minilm
CORRELATION_WINDOW_MIN=30
ROUTER_LLM_THRESHOLD=0.35    # lower edge of the ambiguity band; the upper edge mirrors it
FEATURE_MULTI_AGENT=true
FEATURE_HINDI=true
FEATURE_INJECTION_CLASSIFIER=false
DB_PATH=alertlens.db
SEED=42
