       "proposed",
       "pending_confirmation",
       "approved",
       "rejected",
       "simulated"
      ],
      "title": "Status",
      "default": "proposed"
     },
     "instance_id": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Instance Id"
     },
     "two_step": {
      "type": "boolean",
      "title": "Two Step",
      "default": false
     }
    },
